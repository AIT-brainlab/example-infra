# ==============================================================================
# DPI Center — Domain Landing Zone Seed Bootstrap Configuration
# ==============================================================================
# Instructions:
#   1. Copy this file to .env at the repository root:
#        cp .env.example .env
#   2. Fill in the required variables below (DOMAIN_NAME, BILLING_ACCOUNT_ID).
#   3. Validate your configuration:
#        ./scripts/check_env.sh
#   4. Preview what will be created:
#        ./scripts/bootstrap_domain.sh --plan
#   5. Run the bootstrap script:
#        ./scripts/bootstrap_domain.sh
# ==============================================================================

# --- [REQUIRED] Domain & Billing Identity ---

# DOMAIN_NAME defines the sovereign identity for this initiative:
#   1. Project Name Prefix  : Prefixes ALL projects:
#                             - <DOMAIN_NAME>-mgmt   (Management anchor: state, secrets, DNS)
#                             - <DOMAIN_NAME>-*      (Future workloads: k3s, db, sandboxes)
#   2. Cloud DNS Namespace  : <DOMAIN_NAME>.<PARENT_DOMAIN>
#   3. Git Management Dir   : <DOMAIN_NAME>-mgmt/ (Directory containing Terraform code)
#
# Constraints:
#   - Lowercase letters, numbers, and hyphens only (^[a-z0-9-]+$)
#   - Maximum 24 characters (ensures '<DOMAIN_NAME>-mgmt' fits GCP's 30-char project ID limit)
# Examples: "mosip-asia", "ai-team", "dlms", "sandbox-a"
DOMAIN_NAME="example-domain"

# Google Cloud Billing Account ID (Format: "XXXXXX-XXXXXX-XXXXXX")
# - For Workload Developers: Optional (leave blank ""). Child project envelopes (prj-*.tf)
#   query the billing account dynamically from GCP Secret Manager at runtime.
# - For Management Plane Operators (Day-0 bootstrap, relinking billing, or rotating secrets):
#   Required. Retrieve from Secret Manager:
#     gcloud secrets versions access latest --secret=billing-account-id --project=<domain>-mgmt
BILLING_ACCOUNT_ID=""


# --- [OPTIONAL] Network & Region Settings ---

# Parent apex domain (Leave empty "" if starting fresh without a custom domain / Cloud DNS)
PARENT_DOMAIN=""

# Target GCP region for remote state bucket and resources
REGION="asia-southeast1"

# Remote state bucket name (Default: ${DOMAIN_NAME}-tfstate)
# Guaranteed globally unique; override only if explicitly needed
# STATE_BUCKET="custom-state-bucket-name"


# --- [OPTIONAL] Team Access & Collaborators ---

# Comma-separated list of Project Administrators (granted Editor on the management project)
PROJECT_ADMINS=""

# Comma-separated list of Project Viewers (granted Viewer on the management project)
PROJECT_MEMBERS=""
